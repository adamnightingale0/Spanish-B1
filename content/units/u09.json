  {
   "id": "u09-desac-001",
   "type": "choice",
   "unit": 9,
   "grammarPoint": "desacuerdo-contraargumentar",
   "difficulty": 1,
   "prompt": "—Ayer no sacaste la basura. —¿___ no saqué la basura? ¡Claro que la saqué!",
   "options": [
    "Que",
    "Qué",
    "Cómo que"
   ],
   "answers": [
    "Que"
   ],
   "feedback": "Echo question with que (no accent) repeats what the other person said.",
   "contrast": "¿Qué? = rejection of what was said."
  },
  {
   "id": "u09-desac-002",
   "type": "choice",
   "unit": 9,
   "grammarPoint": "desacuerdo-contraargumentar",
   "difficulty": 2,
   "prompt": "—Tu hermano es un antipático. —Hombre, yo no ___ eso. Lo que pasa es que es tímido.",
   "options": [
    "diría",
