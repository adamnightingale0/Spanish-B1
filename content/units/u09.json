    "dije"
   ],
   "answers": [
    "diría"
   ],
   "feedback": "Yo no diría eso softens disagreement (condicional).",
   "contrast": "¡Qué dices! (strong)."
  },
  {
   "id": "u09-desac-003",
   "type": "choice",
   "unit": 9,
   "grammarPoint": "desacuerdo-contraargumentar",
